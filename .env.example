# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# --- Gmail -----------------------------------------------------------
# GMAIL_APP_PASSWORD NO es tu clave normal: es una "Contrasena de aplicacion"
# de 16 caracteres que se genera en myaccount.google.com/apppasswords
# (requiere tener activada la verificacion en 2 pasos).
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_TO=tucorreo@gmail.com

# --- Proveedor de precios --------------------------------------------
# amazon_scraper (gratis) | keepa (de pago, historico profundo)
PRICE_PROVIDER=amazon_scraper
KEEPA_API_KEY=
